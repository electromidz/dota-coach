# Production environment for the backend, deployed at https://api.belmo.io
#
# These are the values to paste into Belmo's environment-variable UI. Do NOT
# commit the filled-in version and do NOT ship a .env inside the image -
# backend/.dockerignore excludes .env for exactly that reason.
#
# DATABASE_URL is the only variable the process actually requires; every other
# key here has a default in src/config/mod.rs. The ones listed below are the
# ones whose default is wrong for production.

# --- Required ---------------------------------------------------------------
# Supabase, Supavisor SESSION mode (port 5432). Port 6543 is transaction mode
# and breaks sqlx: prepared-statement caching and the migrator's advisory lock
# both fail there with `prepared statement "sqlx_s_1" already exists`.
# Percent-encode reserved characters in the password (`@` -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Bind ------------------------------------------------------------------
# Must listen on all interfaces, not loopback, or the platform's proxy and the
# container HEALTHCHECK cannot reach it.
HOST=0.0.0.0
PORT=8080

# --- Public URLs and cookies ------------------------------------------------
# Steam signs the return_to URL it is handed. If PUBLIC_BASE_URL is not exactly
# the origin the browser reaches, Steam's signature check fails and every login
# is rejected - so this has to be the public HTTPS origin, never an internal
# container hostname or port.
PUBLIC_BASE_URL=https://api.belmo.io
FRONTEND_BASE_URL=https://dashboard.belmo.io

# Comma-separated, explicit. The CORS layer sets allow_credentials(true), which
# forbids a wildcard origin - a `*` here would be rejected, not permissive.
CORS_ORIGINS=https://dashboard.belmo.io

# MUST be true on HTTPS. Left false, the session cookie is sent over plain HTTP
# and is interceptable. Setting it true is also what tells config/mod.rs this is
# a production deployment.
COOKIE_SECURE=true

# 720h = 30 days.
SESSION_TTL_HOURS=720

# --- API documentation ------------------------------------------------------
# Leave UNSET. Unset, docs_enabled() derives `false` from the non-localhost
# PUBLIC_BASE_URL above, which is what production wants: /docs publishes a full
# map of the API to anyone who guesses the path. Set it to true only
# deliberately, and expect it to stay reachable until you unset it.
# DOCS_ENABLED=

# --- Secrets ----------------------------------------------------------------
# Store these as secrets in the panel, not as plain env vars, if Belmo
# distinguishes the two. None of them may ever be prefixed NEXT_PUBLIC_.

# Raises OpenDota's rate limit. Optional - the free tier works unset.
DOTA_API_KEY=

# Coaching model. Unset LLM_API_KEY leaves /api/coach answering 503 while the
# rest of the API keeps working.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# assistance-model style reasoning models spend ~5-6k tokens before emitting
# content; below ~12k total they return finish_reason=length with no answer.
COACH_MAX_OUTPUT_TOKENS=12000
LLM_TIMEOUT_SECONDS=120

# Payments. The API key opens invoices; the IPN secret verifies the HMAC-SHA512
# callbacks. Set both or neither: an API key that cannot verify settlements
# would open charges nothing could ever confirm.
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Billing ----------------------------------------------------------------
# The price lives here and nowhere else.
BILLING_PRICE_CENTS=100
BILLING_CURRENCY=usd
BILLING_TRIAL_DAYS=14
BILLING_PERIOD_DAYS=30
# Set true to actually enforce entitlements on gated routes.
BILLING_ENFORCE=true

# --- Logging ----------------------------------------------------------------
RUST_LOG=dota_coach_backend=info,tower_http=info
