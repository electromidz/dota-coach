# Copy to .env and adjust. Never commit the real file.

# --- Postgres (used by docker compose) ---
POSTGRES_USER=dota
POSTGRES_PASSWORD=dota
POSTGRES_DB=dota_coach
POSTGRES_PORT=5432

# --- Backend ---
# Host-side value for running the backend outside Docker.
# Inside docker compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgres://dota:dota@localhost:5432/dota_coach
HOST=0.0.0.0
PORT=8080
BACKEND_PORT=8080
# Comma-separated, bare origins only: scheme, host, port. No trailing slash and
# no path - an Origin header never has one, so such an entry matches nothing.
CORS_ORIGINS=http://localhost:3000
RUST_LOG=dota_coach_backend=info,tower_http=info

# --- Steam authentication & sessions ---
# Public origin of the API. Steam signs `return_to`, so this must be exactly
# what the browser reaches - not an internal container hostname.
PUBLIC_BASE_URL=http://localhost:8080
# Where the login redirect lands, and where failures return with ?error=<code>.
FRONTEND_BASE_URL=http://localhost:3000
#FRONTEND_BASE_URL=http://172.19.27.37
# Override only for testing. Valve's real endpoint is the default.
STEAM_OPENID_URL=https://steamcommunity.com/openid/login
# Session lifetime. 720h = 30 days.
SESSION_TTL_HOURS=720
# MUST be true in any HTTPS deployment. false only for plain-HTTP localhost.
COOKIE_SECURE=false
# true when the frontend is on a different site than this API - a separate
# deployment, or a local dev server pointed at a hosted backend. Relaxes the
# session cookie to SameSite=None so the browser sends it at all; requires
# COOKIE_SECURE=true, and the API's CORS allowlist becomes the only CSRF
# defence left. Leave false when both share a site.
COOKIE_CROSS_SITE=false

# --- Dota data provider ---
DOTA_API_BASE_URL=https://api.opendota.com/api
# Optional. Raises OpenDota's rate limit; the free tier works without it.
DOTA_API_KEY=
DOTA_API_TIMEOUT_SECONDS=10
# Matches pulled per sync (1-500), counted BEFORE game-mode filtering.
# Competitive analysis reads only Ranked/public All Pick, so a player whose
# history is half Turbo needs roughly twice ROLE_ANALYSIS_MATCH_LIMIT here
# before the full window can be filled. Raising it lengthens a first sync,
# which fetches one match detail per new match.
SYNC_MATCH_LIMIT=20
# Minimum gap between two syncs of the same player. 0 disables throttling.
SYNC_COOLDOWN_SECONDS=30
# How old stored match history may get before reading a match list refreshes it
# in the background. The response still serves the cached rows and says
# `syncing: true`; SYNC_COOLDOWN_SECONDS above still decides whether the call is
# allowed at all, so this can never raise the provider request rate past it.
# 0 turns the background refresh off, leaving POST /api/players/me/sync as the
# only path that calls the provider.
DOTA_STALE_AFTER_SECONDS=900

# --- Match timeline provider (STRATZ) ---
# The source of truth for ONE match's second-by-second record: when each death
# happened and to whom, when each item was completed, when towers fell. OpenDota
# above remains the source of truth for the match history and every aggregate.
#
# Two providers, not one, because they fail independently: a STRATZ outage must
# cost the deep reading of a single match and nothing else. Without a token the
# product runs in full — single-match analysis falls back to the stored match
# totals and says, in the analysis itself, that no timeline was available.
#
# Server-side only. Never prefixed with NEXT_PUBLIC_.
# WARNING: this file is committed. Put the real token in .env, not here.
STRATZ_API_URL=https://api.stratz.com/graphql
# Bearer token from https://stratz.com/api. Empty = feature degrades, not fails.
STRATZ_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJTdWJqZWN0IjoiZmJhYWIwMGItNzk0Ni00ZTdjLThkYTQtMWE4MWM5MDQ5NDMzIiwiU3RlYW1JZCI6IjMxNjE4NDIzOCIsIkFQSVVzZXIiOiJ0cnVlIiwibmJmIjoxNzg5MzA1NTExLCJleHAiOjE4MjA4NDE1MTEsImlhdCI6MTc4OTMwNTUxMSwiaXNzIjoiaHR0cHM6Ly9hcGkuc3RyYXR6LmNvbSJ9.2nOKpGhW9lvFSpucM9q57D9arlZ_uPZgvl2BoqRZD4I
# STRATZ identifies API traffic by user agent and rejects some clients without
# this value. Change it only if STRATZ says to.
STRATZ_USER_AGENT=STRATZ_API
# One call returns a whole match including every player's event stream, so this
# is higher than the OpenDota timeout. It is fetched once per match, not per page.
STRATZ_API_TIMEOUT_SECONDS=20
# How long a PARSED match's timeline is reused. A finished, parsed match is
# immutable, so this only bounds how long a normalization change takes to reach
# an already-cached match. 720h = 30 days.
STRATZ_CACHE_TTL_HOURS=720
# How long an UNPARSED match's reading is reused. Much shorter, because this is
# the one answer that improves on its own: Valve parses replays after the fact,
# so "no timeline available" is a statement about now rather than about the
# match. Re-asking occasionally is how a since-parsed match gains its timeline.
#
# Mind the rate limit when lowering it: STRATZ allows roughly 2,000 calls an
# hour for the whole deployment on a default token, not per user.
STRATZ_UNPARSED_CACHE_TTL_HOURS=6

# --- Role analysis ---
# Eligible matches read by the overall and role analysis (20-500). Applied
# AFTER game-mode filtering: 100 here means 100 Ranked/public All Pick games,
# never 100 raw matches of which some are Turbo.
ROLE_ANALYSIS_MATCH_LIMIT=100
# How a role's 0-100 performance score is composed. Must sum to more than zero;
# they are renormalized, so only the ratios matter. See services::roles.
ROLE_WEIGHT_WIN_RATE=0.45
ROLE_WEIGHT_KILL_PARTICIPATION=0.20
ROLE_WEIGHT_KDA=0.20
ROLE_WEIGHT_DEATHS=0.15

# --- Rank calibration ---
# Two of these describe Valve's model and two describe ours, and the split
# matters.
#
# The confidence pair mirrors the Rank Confidence meter the game itself shows,
# so they should only move if Valve's behaviour does.
CALIB_CONFIDENCE_PER_MATCH=1.5
CALIB_CONFIDENCE_THRESHOLD=30.0
# A gap this long with no ranked match resets the confidence count.
CALIB_DECAY_DAYS=180
# These two are OURS, not Valve's. Dota has not published a per-match MMR
# change in years, so nothing can recover a real delta; these parameterise the
# shape of the modeled stretches between two real rank readings, and every
# point they produce is flagged `estimated` in the API and drawn dashed in the
# UI. They are configuration precisely so the methodology note shown to the
# player can never disagree with the model actually in force — change these
# and the sentence on /calibrating changes with them.
CALIB_WIN_BASE_MMR=30
CALIB_LOSS_BASE_MMR=25

# --- LLM provider (OpenAI-compatible) ---
# Server-side only. Never prefixed with NEXT_PUBLIC_.
# WARNING: this file is committed. Put real keys in .env, not here.
#
# Any server speaking POST {LLM_BASE_URL}/chat/completions works — the client
# sends nothing vendor-specific. Groq's OpenAI-compatible endpoint below;
# https://api.openai.com/v1 or a self-hosted gateway need only these three.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# gpt-oss-120b is a reasoning model: it spends most of this budget thinking
# before it emits any content, and the full coaching prompt needs ~6.5k in
# total. Below this it returns finish_reason=length with an empty answer.
# Groq serves it with a 131k context and a 65,536-token output ceiling, so
# there is room to raise this; the budget is a limit, not an allocation.
#
# The thinking itself never reaches the answer: Groq returns it in a separate
# `reasoning` field and the client reads only `content` (services/llm/openai.rs).
COACH_MAX_OUTPUT_TOKENS=12000
LLM_TIMEOUT_SECONDS=120

# Read-through cache for the coaching context, in Postgres. Invalidation is by
# key derivation — the key carries a fingerprint of the sync time, role, focus,
# newest session and provider snapshot freshness — so the TTL below is only a
# backstop for entries nothing will look up again. Turning it off changes the
# answer not at all, only the number of queries behind it.
COACH_CACHE_ENABLED=true
COACH_CACHE_TTL_MINUTES=60

# Conversational coaching. Questions a player may ask in a rolling 24 hours;
# counted over replies, so an answer refused for quoting an unverifiable figure
# does not spend the budget. No cooldown — a thirty-second gap between messages
# is right for regenerating an analysis and wrong for a conversation.
COACH_CHAT_DAILY_LIMIT=50

# --- Frontend ---
FRONTEND_PORT=3000
# Must be reachable from the browser, not from inside the container.
NEXT_PUBLIC_API_URL=http://localhost:8080
# The public origin of the site itself. Canonical URLs, og:image, robots.txt
# and the sitemap are all absolute and must name the host actually serving
# the page — a canonical pointing somewhere else gets the landing page
# de-duplicated out of the search index.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payment provider (NOWPayments) ---
# Server-side only. Never prefixed with NEXT_PUBLIC_.
# WARNING: this file is committed. Put real keys in .env, not here.
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
# Opens invoices. Without it, checkout answers 503 and everything else works.
NOWPAYMENTS_API_KEY=
# Verifies IPN callbacks (HMAC-SHA512). Required: an API key that cannot verify
# settlements would open charges nothing could ever confirm.
NOWPAYMENTS_IPN_SECRET=
# Restrict checkout to one coin. Unset lets the payer choose on the hosted page.
#NOWPAYMENTS_PAY_CURRENCY=usdttrc20
BILLING_TIMEOUT_SECONDS=15

