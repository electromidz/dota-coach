# Copy to .env and adjust. Never commit the real file.

# --- Postgres (used by docker compose) ---
POSTGRES_USER=dota
POSTGRES_PASSWORD=dota
POSTGRES_DB=dota_coach
POSTGRES_PORT=5432

# --- Backend ---
# Host-side value for running the backend outside Docker.
# Inside docker compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgres://dota:dota@localhost:5432/dota_coach
HOST=0.0.0.0
PORT=8080
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:3000
RUST_LOG=dota_coach_backend=info,tower_http=info

# Swagger UI at /docs and the OpenAPI document at /api-docs/openapi.json.
# Unset, it follows PUBLIC_BASE_URL: on for localhost, off everywhere else, so
# production never publishes the API's map by default. Set it explicitly to
# override in either direction. `true` or `false` only - anything else fails
# the boot rather than quietly resolving to off.
#DOCS_ENABLED=true

# --- Steam authentication & sessions ---
# Public origin of the API. Steam signs `return_to`, so this must be exactly
# what the browser reaches - not an internal container hostname.
PUBLIC_BASE_URL=http://localhost:8080
# Where the login redirect lands, and where failures return with ?error=<code>.
FRONTEND_BASE_URL=http://localhost:3000
# Override only for testing. Valve's real endpoint is the default.
STEAM_OPENID_URL=https://steamcommunity.com/openid/login
# Session lifetime. 720h = 30 days.
SESSION_TTL_HOURS=720
# MUST be true in any HTTPS deployment. false only for plain-HTTP localhost.
COOKIE_SECURE=false

# --- Dota data provider ---
DOTA_API_BASE_URL=https://api.opendota.com/api
# Optional. Raises OpenDota's rate limit; the free tier works without it.
DOTA_API_KEY=
DOTA_API_TIMEOUT_SECONDS=10
# Matches pulled per sync (1-100).
SYNC_MATCH_LIMIT=20
# Restrict syncing to OpenDota's "significant" modes - standard competitive
# play, which excludes Turbo, Ability Draft and event modes. Off by default:
# OpenDota applies this filter unless told otherwise, and it is invisible in the
# response, so a mostly-Turbo player's sync succeeds and silently finds nothing.
# Turn it on only if the analysis should ignore non-competitive games entirely.
#DOTA_SIGNIFICANT_ONLY=false
# Minimum gap between two syncs of the same player. 0 disables throttling.
SYNC_COOLDOWN_SECONDS=30
# How long a cached peer distribution stays fresh.
BENCHMARK_TTL_HOURS=24

# --- Hero intelligence ---
# How long a cached hero meta cohort stays fresh.
HERO_META_TTL_HOURS=24
# Candidates returned by the recommendation endpoints (1-50).
HERO_RECOMMENDATION_LIMIT=8
# Peer distributions fetched per recommendation request. Each is an upstream
# call, so the benchmark component is filled in for the most-played heroes only.
HERO_BENCHMARK_LOOKUPS=5
# Hero Fit Score weights (PRODUCT_SPEC.md section 19). Tune without a rebuild;
# a component with no data is dropped and the rest are renormalized.
FIT_WEIGHT_PERFORMANCE=0.30
FIT_WEIGHT_META=0.25
FIT_WEIGHT_EXPERIENCE=0.20
FIT_WEIGHT_BENCHMARK=0.15
FIT_WEIGHT_RECENT_FORM=0.10

# --- Training focus ---
# Relative weights of the selection inputs (PRODUCT_SPEC.md section 28).
# The inputs are the spec's; only their weighting is configuration.
FOCUS_WEIGHT_GAP=0.25
FOCUS_WEIGHT_PATTERN=0.20
FOCUS_WEIGHT_RECENT=0.15
FOCUS_WEIGHT_IMPACT=0.20
FOCUS_WEIGHT_CONFIDENCE=0.10
FOCUS_WEIGHT_RECENCY=0.10
# Past focuses returned alongside the current one.
FOCUS_HISTORY_LIMIT=10

# --- AI coaching ---
# Minimum gap between two generations for one player.
COACH_COOLDOWN_SECONDS=30
# Generations per player per rolling 24 hours. 0 disables the cap.
COACH_DAILY_LIMIT=20
# Ceiling on insights kept from one answer.
COACH_MAX_INSIGHTS=5
# A reasoning model spends most of this on thinking before it emits a single
# character of the answer. Measured against `assistance-model` below, the full
# coaching prompt burns 5.7k-6.5k tokens per call, and a player with a wider
# hero pool sends more evidence and costs more. Anything too low returns
# finish_reason=length and an empty answer, so this is set well clear of the
# measured range rather than next to it. Ceiling is 16000. Lower it only for a
# model that does not think.
COACH_MAX_OUTPUT_TOKENS=12000
# Interpretation of fixed numbers, not creative writing.
COACH_TEMPERATURE=0.2
# Matches feeding the recent-form evidence.
COACH_RECENT_MATCHES=10
# How long one model call may take before it is abandoned. A thinking model
# answering the full prompt runs 70-120s; 30 is only enough for a model that
# starts writing immediately. Ceiling is 180.
LLM_TIMEOUT_SECONDS=120

# --- LLM provider (OpenAI-compatible) ---
# Server-side only. Never prefixed with NEXT_PUBLIC_.
# WARNING: this file is committed. Put real keys in .env, not here.
# Any OpenAI-compatible /chat/completions endpoint.
LLM_BASE_URL=https://aifa-chatbot.sandpod.ir/v1
LLM_API_KEY=4116420628-db93b0e6bbf64c31831ccf7873dd863a.XzIwMjY4
# The coaching prompt asks for strict JSON; verify a model honours it before
# switching. On the endpoint above, `developer-model` answers correctly.
#LLM_MODEL=developer-model
LLM_MODEL=assistance-model

# --- Billing ---
# The offer. `$1/month` is a launch decision, not an invariant: the price lives
# here in minor units and nowhere else in the system.
BILLING_PLAN=pro
BILLING_PRICE_CENTS=100
BILLING_CURRENCY=usd
BILLING_TRIAL_DAYS=14
BILLING_PERIOD_DAYS=30
# Charges returned by /api/billing and /api/billing/payments.
BILLING_HISTORY_LIMIT=20
# Whether an expired account actually loses AI coaching. Defaults to on only
# when the payment provider below is configured: a deployment that cannot take
# money has no business telling anyone to pay.
#BILLING_ENFORCE=false

# --- Payment provider (NOWPayments) ---
# Server-side only. Never prefixed with NEXT_PUBLIC_.
# WARNING: this file is committed. Put real keys in .env, not here.
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
# Opens invoices. Without it, checkout answers 503 and everything else works.
#NOWPAYMENTS_API_KEY=
# Verifies IPN callbacks (HMAC-SHA512). Required: an API key that cannot verify
# settlements would open charges nothing could ever confirm.
#NOWPAYMENTS_IPN_SECRET=
# Restrict checkout to one coin. Unset lets the payer choose on the hosted page.
#NOWPAYMENTS_PAY_CURRENCY=usdttrc20
BILLING_TIMEOUT_SECONDS=15

# --- Frontend ---
FRONTEND_PORT=3000
# Must be reachable from the browser, not from inside the container.
NEXT_PUBLIC_API_URL=http://localhost:8080
